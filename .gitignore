# ---------------------------------------------------------------------------
# Material Vision AI (MVAI) - repository ignore rules
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# Node / frontend
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo
.eslintcache

# Environment / secrets  (never commit real credentials)
.env
.env.local
.env.*.local
*.pem
*.key

# Runtime data (generated by the pipeline)
uploads/*
!uploads/.gitkeep
exports/*
!exports/.gitkeep
logs/*
!logs/.gitkeep
image-cache/*
!image-cache/.gitkeep
image-library/**/*
!image-library/**/.gitkeep

# Local database fallback (SQLite)
*.db
*.db-journal
*.sqlite3

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
